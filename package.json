{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "api": "node server.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac pkg --publish never",
    "dist:linux": "electron-builder --linux flatpak --publish never",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  },
  "build": {
    "appId": "app.openchat.v2",
    "productName": "OpenChat V2",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "OpenChatV2-Setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "OpenChat V2"
    },
    "mac": {
      "target": "pkg",
      "category": "public.app-category.social-networking",
      "artifactName": "OpenChatV2-macOS.${ext}",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "flatpak",
      "category": "Network",
      "artifactName": "OpenChatV2.${ext}",
      "icon": "build/icon.png"
    },
    "flatpak": {
      "sdk": "org.freedesktop.Sdk//25.08",
      "runtime": "org.freedesktop.Platform//25.08",
      "base": "org.electronjs.Electron2.BaseApp//25.08",
      "finishArgs": [
        "--share=network",
        "--share=ipc",
        "--socket=pulseaudio",
        "--socket=x11",
        "--device=dri"
      ]
    }
  }
}
